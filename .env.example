# Database Configuration (Vercel Postgres)
# Get these values from: https://vercel.com/dashboard > Your Project > Storage > Connect
POSTGRES_PRISMA_URL="your-postgres-prisma-url-here"
POSTGRES_URL_NON_POOLING="your-postgres-url-non-pooling-here"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Admin User Configuration
# This email will be automatically set as ADMIN on first registration
ADMIN_EMAIL="your-email@example.com"
